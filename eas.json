{
  "cli": {
    "version": ">= 25.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_NOTIFICATION_BACKEND_URL": "https://rocket-notifications.vercel.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_NOTIFICATION_BACKEND_URL": "https://rocket-notifications.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_NOTIFICATION_BACKEND_URL": "https://rocket-notifications.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
