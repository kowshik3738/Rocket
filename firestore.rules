              && request.resource.data.replyToMessageId.size() > 0
              && request.resource.data.replyToMessageId.size() <= 100
              && request.resource.data.replyToSenderId is string
              && request.resource.data.replyToSenderId.size() > 0
              && request.resource.data.replyToSenderId.size() <= 100
              && request.resource.data.replyToText is string
