              && request.resource.data.text.size() >= 0)
            || (request.resource.data.keys().hasAll(['liveLocationShareId', 'locationType'])
              && request.resource.data.locationType == 'live'
              && request.resource.data.liveLocationShareId is string
              && request.resource.data.liveLocationShareId.size() > 0
              && request.resource.data.liveLocationShareId.size() <= 100
              && !request.resource.data.keys().hasAny([
                'location', 'imageUrl', 'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'viewOnce', 'viewedAt', 'audioUrl', 'audioDurationMs', 'audioMimeType'
              ])
              && !request.resource.data.keys().hasAny(['forwarded'])
              && request.resource.data.senderId != request.resource.data.recipientId
              && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/liveLocations/$(request.resource.data.liveLocationShareId)).data.ownerId == request.resource.data.senderId
