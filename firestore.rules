            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.adminIds == resource.data.adminIds
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessageAt is timestamp
            && request.resource.data.lastMessageSenderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage', 'lastMessageAt', 'lastMessageSenderId', 'updatedAt'
            ])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll([
              'lastMessage', 'lastMessageAt', 'lastMessageSenderId', 'updatedAt'
            ])))
        && (request.resource.data.lastMessage is string || request.resource.data.lastMessage == null)
        && (request.resource.data.lastMessageAt is timestamp || request.resource.data.lastMessageAt == null)
        && (request.resource.data.lastMessageSenderId is string || request.resource.data.lastMessageSenderId == null);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isVerifiedUser()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if isVerifiedUser()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'imageUrl', 'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'audioUrl', 'audioDurationMs', 'audioMimeType', 'createdAt',
            'forwarded',
            'location', 'locationType', 'liveLocationShareId'
          ])
          && (!request.resource.data.keys().hasAny(['locationType'])
            || request.resource.data.locationType in ['current', 'live'])
          && (!request.resource.data.keys().hasAny(['forwarded'])
            || (request.resource.data.forwarded is bool && request.resource.data.forwarded == true))
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.createdAt is timestamp
          && ((request.resource.data.text.size() > 0
              && !request.resource.data.keys().hasAny([
                'imageUrl', 'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'location', 'locationType', 'liveLocationShareId', 'audioUrl', 'audioDurationMs', 'audioMimeType'
              ]))
            || (request.resource.data.keys().hasAny(['imageUrl'])
              && !request.resource.data.keys().hasAny([
                'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'location', 'locationType', 'liveLocationShareId', 'audioUrl', 'audioDurationMs', 'audioMimeType'
              ])
              && request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.matches('^https://.*$'))
            || (request.resource.data.keys().hasAny(['videoUrl'])
              && !request.resource.data.keys().hasAny([
                'imageUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'location', 'locationType', 'liveLocationShareId', 'audioUrl', 'audioDurationMs', 'audioMimeType'
              ])
              && request.resource.data.videoUrl is string
              && request.resource.data.videoUrl.matches('^https://.*$'))
            || (request.resource.data.keys().hasAll(['fileUrl', 'fileName'])
              && !request.resource.data.keys().hasAny(['imageUrl', 'videoUrl', 'location', 'locationType', 'liveLocationShareId', 'audioUrl', 'audioDurationMs', 'audioMimeType'])
              && request.resource.data.fileUrl is string
              && request.resource.data.fileUrl.matches('^https://.*$')
              && request.resource.data.fileName is string
              && request.resource.data.fileName.size() > 0
              && (!request.resource.data.keys().hasAny(['fileSize']) || (request.resource.data.fileSize is int && request.resource.data.fileSize >= 0))
              && (!request.resource.data.keys().hasAny(['fileMimeType']) || (request.resource.data.fileMimeType is string && request.resource.data.fileMimeType.size() > 0)))
            || (request.resource.data.keys().hasAll(['location', 'locationType'])
              && request.resource.data.locationType == 'current'
              && request.resource.data.location is map
              && request.resource.data.location.keys().hasOnly(['latitude', 'longitude'])
              && request.resource.data.location.latitude is number
              && request.resource.data.location.latitude >= -90.0
              && request.resource.data.location.latitude <= 90.0
              && request.resource.data.location.longitude is number
              && request.resource.data.location.longitude >= -180.0
              && request.resource.data.location.longitude <= 180.0
              && !request.resource.data.keys().hasAny([
                'liveLocationShareId', 'imageUrl', 'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'viewOnce', 'viewedAt', 'audioUrl', 'audioDurationMs', 'audioMimeType'
              ])
              && !request.resource.data.keys().hasAny(['forwarded']))
            || (request.resource.data.keys().hasAll(['liveLocationShareId', 'locationType'])
              && request.resource.data.locationType == 'live'
              && request.resource.data.liveLocationShareId is string
              && request.resource.data.liveLocationShareId.size() > 0
              && request.resource.data.liveLocationShareId.size() <= 100
              && !request.resource.data.keys().hasAny([
                'location', 'imageUrl', 'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'viewOnce', 'viewedAt', 'audioUrl', 'audioDurationMs', 'audioMimeType'
              ])
              && !request.resource.data.keys().hasAny(['forwarded'])
              && getAfter(/databases/$(database)/documents/groups/$(groupId)/liveLocations/$(request.resource.data.liveLocationShareId)).data.ownerId == request.resource.data.senderId)
            || (request.resource.data.keys().hasAll(['audioUrl', 'audioDurationMs'])
              && request.resource.data.audioUrl is string
              && request.resource.data.audioUrl.matches('^https://res\\.cloudinary\\.com/cmpoe94k/video/upload/.*$')
              && request.resource.data.audioDurationMs is number
              && request.resource.data.audioDurationMs > 0
              && request.resource.data.audioDurationMs <= 600000
              && (!request.resource.data.keys().hasAny(['audioMimeType']) || request.resource.data.audioMimeType is string)
              && !request.resource.data.keys().hasAny([
                'imageUrl', 'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'location', 'locationType', 'liveLocationShareId'
              ])
              && (!request.resource.data.keys().hasAny(['forwarded']) || (request.resource.data.forwarded is bool && request.resource.data.forwarded == true))
              && request.resource.data.text.size() >= 0));
        allow update, delete: if false;
      }

      match /liveLocations/{shareId} {
        function isGroupMember() {
          return isVerifiedUser()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }

        allow read: if isGroupMember();
        allow create: if isGroupMember()
          && request.resource.data.keys().hasOnly(['ownerId', 'latitude', 'longitude', 'startedAt', 'expiresAt', 'stoppedAt', 'updatedAt', 'durationMinutes'])
          && request.resource.data.keys().hasAll(['ownerId', 'latitude', 'longitude', 'startedAt', 'expiresAt', 'updatedAt', 'durationMinutes'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.latitude is number && request.resource.data.latitude >= -90.0 && request.resource.data.latitude <= 90.0
          && request.resource.data.longitude is number && request.resource.data.longitude >= -180.0 && request.resource.data.longitude <= 180.0
          && request.resource.data.startedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.stoppedAt == null
          && request.resource.data.durationMinutes in [15, 60, 480]
          && request.resource.data.expiresAt >= request.time + duration.value(request.resource.data.durationMinutes, 'm') - duration.value(1, 'm')
          && request.resource.data.expiresAt <= request.time + duration.value(request.resource.data.durationMinutes, 'm') + duration.value(1, 'm');
        allow update: if isGroupMember()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.durationMinutes == resource.data.durationMinutes
          && (
            (resource.data.stoppedAt == null
              && request.time < resource.data.expiresAt
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['latitude', 'longitude', 'updatedAt'])
              && request.resource.data.diff(resource.data).affectedKeys().hasAll(['latitude', 'longitude', 'updatedAt'])
              && request.resource.data.latitude is number && request.resource.data.latitude >= -90.0 && request.resource.data.latitude <= 90.0
              && request.resource.data.longitude is number && request.resource.data.longitude >= -180.0 && request.resource.data.longitude <= 180.0
              && request.resource.data.updatedAt == request.time)
            ||
            (resource.data.stoppedAt == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stoppedAt', 'updatedAt'])
              && request.resource.data.diff(resource.data).affectedKeys().hasAll(['stoppedAt', 'updatedAt'])
              && request.resource.data.stoppedAt == request.time
              && request.resource.data.updatedAt == request.time)
          );
        allow delete: if false;
      }
    }
  }
}
