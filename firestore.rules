              && !request.resource.data.keys().hasAny([
                'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'location', 'locationType', 'liveLocationShareId', 'audioUrl', 'audioDurationMs', 'audioMimeType'
              ])
              && request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.matches('^https://.*$')
              && request.resource.data.text.size() >= 0)
            || (request.resource.data.keys().hasAny(['videoUrl'])
              && !request.resource.data.keys().hasAny([
                'imageUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'location', 'locationType', 'liveLocationShareId', 'audioUrl', 'audioDurationMs', 'audioMimeType'
              ])
