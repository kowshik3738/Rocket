              || ((!target.keys().hasAny(['viewOnce']) || target.viewOnce != true)
                && (
                  (target.keys().hasAny(['imageUrl']) && msgData.replyToType == 'image')
                  || (target.keys().hasAny(['videoUrl']) && msgData.replyToType == 'video')
                  || (target.keys().hasAny(['fileUrl']) && msgData.replyToType == 'file')
                  || (target.keys().hasAny(['audioUrl']) && msgData.replyToType == 'audio' && msgData.replyToText == 'Voice message')
                  || (!target.keys().hasAny(['imageUrl', 'videoUrl', 'fileUrl', 'audioUrl']) && msgData.replyToType == 'text')
                ))
