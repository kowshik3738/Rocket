          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.createdAt is timestamp
          && (!request.resource.data.keys().hasAny(['deliveredAt'])
            || request.resource.data.deliveredAt == null
            || request.resource.data.deliveredAt is timestamp)
          && (!request.resource.data.keys().hasAny(['seenAt'])
            || request.resource.data.seenAt == null
            || request.resource.data.seenAt is timestamp)
          && (!request.resource.data.keys().hasAny(['replyToMessageId', 'replyToSenderId', 'replyToText', 'replyToType'])
            || (request.resource.data.keys().hasAll(['replyToMessageId', 'replyToSenderId', 'replyToText', 'replyToType'])
