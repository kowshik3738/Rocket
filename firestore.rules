              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedAt'])
              && request.resource.data.viewedAt is timestamp)
            ||
            (resource.data.recipientId == request.auth.uid
              && !resource.data.keys().hasAny(['callId'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt', 'seenAt'])
              && request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveredAt', 'seenAt'])
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveredAt'])
