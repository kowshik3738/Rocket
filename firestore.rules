            && ((get(/databases/$(database)/documents/friendships/$(conversationId)).data.userA == request.resource.data.participantA
              && get(/databases/$(database)/documents/friendships/$(conversationId)).data.userB == request.resource.data.participantB)
              || (get(/databases/$(database)/documents/friendships/$(conversationId)).data.userA == request.resource.data.participantB
              && get(/databases/$(database)/documents/friendships/$(conversationId)).data.userB == request.resource.data.participantA))
          )
