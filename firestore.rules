              && (!request.resource.data.keys().hasAny(['audioMimeType']) || request.resource.data.audioMimeType is string)
              && !request.resource.data.keys().hasAny([
                'imageUrl', 'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'location', 'locationType', 'liveLocationShareId', 'viewOnce', 'viewedAt'
