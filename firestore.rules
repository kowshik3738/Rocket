                  && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])))
              && (!request.resource.data.reactions.keys().hasAny([request.auth.uid])
                || request.resource.data.reactions[request.auth.uid] in ['❤️', '👍', '😂', '😮', '😢', '🔥']))
            ||
            (resource.data.senderId == request.auth.uid
              && !resource.data.keys().hasAny(['callId', 'viewOnce', 'imageUrl', 'videoUrl', 'fileUrl', 'deletedAt', 'location', 'locationType', 'liveLocationShareId', 'audioUrl', 'audioDurationMs', 'audioMimeType'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 5000
              && request.resource.data.editedAt is timestamp
              && request.resource.data.editedAt == request.time)
            ||
            (resource.data.senderId == request.auth.uid
              && !resource.data.keys().hasAny(['callId', 'deletedAt'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy'])
              && request.resource.data.deletedAt is timestamp
              && request.resource.data.deletedAt == request.time
