              && ((get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantA == request.auth.uid
                && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantB == request.resource.data.recipientId)
                || (get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantB == request.auth.uid
                && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantA == request.resource.data.recipientId))
              && noBlockExists(request.resource.data.senderId, request.resource.data.recipientId)
              && exists(/databases/$(database)/documents/friendships/$(conversationId))
