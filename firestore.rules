        }

        function validCallHistoryForTerminalCall() {
          let call = get(/databases/$(database)/documents/calls/$(request.resource.data.callId)).data;
          let conversation = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return call.conversationId == conversationId
