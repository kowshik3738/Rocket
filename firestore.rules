rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function noBlockExists(userA, userB) {
      return !exists(/databases/$(database)/documents/userBlocks/$(userA + '_' + userB))
        && !exists(/databases/$(database)/documents/userBlocks/$(userB + '_' + userA));
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'usernameLower', 'bio', 'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 150
        && request.resource.data.usernameLower.matches('^[a-z0-9_.]{3,30}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.matches('^[a-z0-9_.]{3,30}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 150
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'usernameLower', 'bio', 'createdAt'
        ])
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == request.auth.uid
        && (request.resource.data.usernameLower == resource.data.usernameLower
          || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.usernameLower)));
      allow delete: if false;
    }

    match /usernames/{usernameLower} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && usernameLower.matches('^[a-z0-9_.]{3,30}$')
        && usernameLower == usernameLower.lower()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /userBlocks/{blockId} {
      allow get: if request.auth != null
        && (resource == null
          ? blockId.matches('^' + request.auth.uid + '_.*$')
          : resource.data.blockerUid == request.auth.uid);
      allow list: if request.auth != null
        && resource.data.blockerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['blockerUid', 'blockedUid', 'createdAt'])
        && blockId == request.resource.data.blockerUid + '_' + request.resource.data.blockedUid
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid != request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.blockerUid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      function noFriendshipExists(senderId, recipientId) {
        return (senderId < recipientId
          && !exists(/databases/$(database)/documents/friendships/$(senderId + '_' + recipientId)))
          || (senderId > recipientId
            && !exists(/databases/$(database)/documents/friendships/$(recipientId + '_' + senderId)));
      }

      function hasNoActiveReverseRequest(senderId, recipientId) {
        return !exists(/databases/$(database)/documents/friendRequests/$(recipientId + '_' + senderId))
          || get(/databases/$(database)/documents/friendRequests/$(recipientId + '_' + senderId)).data.status == 'declined';
      }

      function canStartFriendRequest(senderId, recipientId) {
        return noFriendshipExists(senderId, recipientId)
          && hasNoActiveReverseRequest(senderId, recipientId)
          && noBlockExists(senderId, recipientId);
      }

      function hasAuthoritativeFriendshipAfter(friendRequest) {
        return ((friendRequest.senderId < friendRequest.recipientId
          && existsAfter(/databases/$(database)/documents/friendships/$(friendRequest.senderId + '_' + friendRequest.recipientId)))
          || (friendRequest.senderId > friendRequest.recipientId
            && existsAfter(/databases/$(database)/documents/friendships/$(friendRequest.recipientId + '_' + friendRequest.senderId))))
          && existsAfter(/databases/$(database)/documents/userFriends/$(friendRequest.senderId + '_' + friendRequest.recipientId))
          && existsAfter(/databases/$(database)/documents/userFriends/$(friendRequest.recipientId + '_' + friendRequest.senderId));
      }

      function hasAuthoritativeFriendshipRemovedAfter(friendRequest) {
        return ((friendRequest.senderId < friendRequest.recipientId
          && !existsAfter(/databases/$(database)/documents/friendships/$(friendRequest.senderId + '_' + friendRequest.recipientId)))
          || (friendRequest.senderId > friendRequest.recipientId
            && !existsAfter(/databases/$(database)/documents/friendships/$(friendRequest.recipientId + '_' + friendRequest.senderId))))
          && !existsAfter(/databases/$(database)/documents/userFriends/$(friendRequest.senderId + '_' + friendRequest.recipientId))
          && !existsAfter(/databases/$(database)/documents/userFriends/$(friendRequest.recipientId + '_' + friendRequest.senderId));
      }

      allow read: if request.auth != null
        && (resource == null || resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['senderId', 'recipientId', 'status', 'createdAt'])
        && requestId == request.resource.data.senderId + '_' + request.resource.data.recipientId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && canStartFriendRequest(request.resource.data.senderId, request.resource.data.recipientId);
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'senderId', 'recipientId', 'status', 'createdAt', 'acceptedAt', 'declinedAt'
        ])
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.createdAt == resource.data.createdAt
        && ((resource.data.recipientId == request.auth.uid
          && resource.data.status == 'pending'
          && ((request.resource.data.status == 'accepted'
            && request.resource.data.acceptedAt is timestamp
            && !request.resource.data.keys().hasAny(['declinedAt'])
            && noBlockExists(resource.data.senderId, resource.data.recipientId)
            && hasAuthoritativeFriendshipAfter(request.resource.data))
            || (request.resource.data.status == 'declined'
              && request.resource.data.declinedAt is timestamp
              && !request.resource.data.keys().hasAny(['acceptedAt']))))
          || (resource.data.senderId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'declined'
            && request.resource.data.declinedAt is timestamp
            && !request.resource.data.keys().hasAny(['acceptedAt']))
          || (resource.data.senderId == request.auth.uid
            && resource.data.status == 'declined'
            && request.resource.data.keys().hasOnly(['senderId', 'recipientId', 'status', 'createdAt'])
            && request.resource.data.status == 'pending'
            && canStartFriendRequest(resource.data.senderId, resource.data.recipientId))
          || ((resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid)
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'declined'
            && request.resource.data.declinedAt is timestamp
            && !request.resource.data.keys().hasAny(['acceptedAt'])
            && hasAuthoritativeFriendshipRemovedAfter(resource.data)));
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      function matchesAcceptedFriendRequest(friendship) {
        let friendRequest = getAfter(/databases/$(database)/documents/friendRequests/$(friendship.requestId)).data;
        return friendRequest.status == 'accepted'
          && ((friendRequest.senderId == friendship.userA
            && friendRequest.recipientId == friendship.userB)
            || (friendRequest.senderId == friendship.userB
              && friendRequest.recipientId == friendship.userA));
      }

      allow read: if request.auth != null
        && (resource == null || resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userA', 'userB', 'requestId', 'createdAt'])
        && ((request.resource.data.userA < request.resource.data.userB
          && friendshipId == request.resource.data.userA + '_' + request.resource.data.userB)
          || (request.resource.data.userB < request.resource.data.userA
          && friendshipId == request.resource.data.userB + '_' + request.resource.data.userA))
        && request.resource.data.userA != request.resource.data.userB
        && (request.auth.uid == request.resource.data.userA || request.auth.uid == request.resource.data.userB)
        && request.resource.data.createdAt is timestamp
        && noBlockExists(request.resource.data.userA, request.resource.data.userB)
        && matchesAcceptedFriendRequest(request.resource.data);
      allow update: if false;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.userA || request.auth.uid == resource.data.userB)
        && getAfter(/databases/$(database)/documents/friendRequests/$(resource.data.requestId)).data.status == 'declined'
        && !existsAfter(/databases/$(database)/documents/userFriends/$(resource.data.userA + '_' + resource.data.userB))
        && !existsAfter(/databases/$(database)/documents/userFriends/$(resource.data.userB + '_' + resource.data.userA));
    }

    match /userFriends/{friendshipId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['ownerId', 'friendId', 'requestId', 'createdAt'])
        && friendshipId == request.resource.data.ownerId + '_' + request.resource.data.friendId
        && request.resource.data.ownerId != request.resource.data.friendId
        && (request.auth.uid == request.resource.data.ownerId || request.auth.uid == request.resource.data.friendId)
        && request.resource.data.createdAt is timestamp
        && noBlockExists(request.resource.data.ownerId, request.resource.data.friendId)
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
        && ((getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId == request.resource.data.ownerId
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.recipientId == request.resource.data.friendId)
          || (getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId == request.resource.data.friendId
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.recipientId == request.resource.data.ownerId));
      allow update: if false;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.friendId)
        && getAfter(/databases/$(database)/documents/friendRequests/$(resource.data.requestId)).data.status == 'declined'
        && ((resource.data.ownerId < resource.data.friendId
          && !existsAfter(/databases/$(database)/documents/friendships/$(resource.data.ownerId + '_' + resource.data.friendId)))
          || (resource.data.friendId < resource.data.ownerId
          && !existsAfter(/databases/$(database)/documents/friendships/$(resource.data.friendId + '_' + resource.data.ownerId))))
        && !existsAfter(/databases/$(database)/documents/userFriends/$(resource.data.friendId + '_' + resource.data.ownerId));
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.participantA == request.auth.uid || resource.data.participantB == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'participantA', 'participantB', 'createdAt', 'lastMessage', 'lastMessageAt', 'lastMessageSenderId'
        ])
        && request.resource.data.participantA != request.resource.data.participantB
        && ((request.resource.data.participantA < request.resource.data.participantB
          && conversationId == request.resource.data.participantA + '_' + request.resource.data.participantB)
          || (request.resource.data.participantB < request.resource.data.participantA
          && conversationId == request.resource.data.participantB + '_' + request.resource.data.participantA))
        && (request.auth.uid == request.resource.data.participantA || request.auth.uid == request.resource.data.participantB)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastMessage == null
        && request.resource.data.lastMessageAt == null
        && request.resource.data.lastMessageSenderId == null
        && noBlockExists(request.resource.data.participantA, request.resource.data.participantB)
        && get(/databases/$(database)/documents/friendships/$(conversationId)).data.userA != null
        && ((get(/databases/$(database)/documents/friendships/$(conversationId)).data.userA == request.resource.data.participantA
          && get(/databases/$(database)/documents/friendships/$(conversationId)).data.userB == request.resource.data.participantB)
          || (get(/databases/$(database)/documents/friendships/$(conversationId)).data.userA == request.resource.data.participantB
          && get(/databases/$(database)/documents/friendships/$(conversationId)).data.userB == request.resource.data.participantA));
      allow update: if request.auth != null
        && (resource.data.participantA == request.auth.uid || resource.data.participantB == request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'participantA', 'participantB', 'createdAt', 'lastMessage', 'lastMessageAt', 'lastMessageSenderId'
        ])
        && request.resource.data.participantA == resource.data.participantA
        && request.resource.data.participantB == resource.data.participantB
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.lastMessageSenderId == request.auth.uid
        && noBlockExists(resource.data.participantA, resource.data.participantB)
        && exists(/databases/$(database)/documents/friendships/$(conversationId));
      allow delete: if false;

      match /messages/{messageId} {
        function validCallHistory(messageId) {
          return request.auth != null
            && request.resource.data.keys().hasAll([
              'callId', 'callerId', 'calleeId', 'callOutcome',
              'callEndedAt', 'createdAt'
            ])
            && request.resource.data.keys().hasOnly([
              'callId', 'callerId', 'calleeId', 'callOutcome',
              'callAnsweredAt', 'callEndedAt', 'createdAt'
            ])
            && request.resource.data.callId is string
            && request.resource.data.callerId is string
            && request.resource.data.calleeId is string
            && request.resource.data.callEndedAt is timestamp
            && request.resource.data.createdAt is timestamp
            && messageId == 'call_' + request.resource.data.callId
            && validCallHistoryForTerminalCall();
        }

        function validCallHistoryForTerminalCall() {
          let call = get(/databases/$(database)/documents/calls/$(request.resource.data.callId)).data;
          let conversation = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return call.conversationId == conversationId
            && call.kind == 'voice'
            && call.callerId == request.resource.data.callerId
            && call.calleeId == request.resource.data.calleeId
            && call.callerId != call.calleeId
            && (request.auth.uid == call.callerId || request.auth.uid == call.calleeId)
            && ((conversation.participantA == call.callerId && conversation.participantB == call.calleeId)
              || (conversation.participantB == call.callerId && conversation.participantA == call.calleeId))
            && call.endedAt is timestamp
            && request.resource.data.callEndedAt == call.endedAt
            && request.resource.data.createdAt == call.endedAt
            && ((request.resource.data.callOutcome == 'cancelled'
              && call.phase == 'cancelled'
              && !request.resource.data.keys().hasAny(['callAnsweredAt']))
              || (request.resource.data.callOutcome == 'declined'
                && call.phase == 'declined'
                && !request.resource.data.keys().hasAny(['callAnsweredAt']))
              || (request.resource.data.callOutcome == 'completed'
                && call.phase == 'ended'
                && call.answeredAt is timestamp
                && request.resource.data.keys().hasAll(['callAnsweredAt'])
                && request.resource.data.callAnsweredAt is timestamp
                && request.resource.data.callAnsweredAt == call.answeredAt));
        }

        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantA == request.auth.uid
            || get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantB == request.auth.uid);
        allow create: if (request.auth != null
          && request.resource.data.keys().hasOnly([
            'senderId', 'recipientId', 'text', 'imageUrl', 'videoUrl',
            'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'viewOnce', 'viewedAt', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.createdAt is timestamp
          && ((request.resource.data.text.size() > 0
              && !request.resource.data.keys().hasAny([
                'imageUrl', 'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType'
              ]))
            || (request.resource.data.keys().hasAny(['imageUrl'])
              && !request.resource.data.keys().hasAny([
                'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType'
              ])
              && request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.matches('^https://.*$')
              && request.resource.data.text.size() >= 0)
            || (request.resource.data.keys().hasAny(['videoUrl'])
              && !request.resource.data.keys().hasAny([
                'imageUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType'
              ])
              && request.resource.data.videoUrl is string
              && request.resource.data.videoUrl.matches('^https://.*$')
              && request.resource.data.text.size() >= 0)
            || (request.resource.data.keys().hasAll(['fileUrl', 'fileName'])
              && !request.resource.data.keys().hasAny(['imageUrl', 'videoUrl'])
              && request.resource.data.fileUrl is string
              && request.resource.data.fileUrl.matches('^https://.*$')
              && request.resource.data.fileName is string
              && request.resource.data.fileName.size() > 0
              && (!request.resource.data.keys().hasAny(['fileSize'])
                || (request.resource.data.fileSize is int
                  && request.resource.data.fileSize >= 0))
              && (!request.resource.data.keys().hasAny(['fileMimeType'])
                || (request.resource.data.fileMimeType is string
                  && request.resource.data.fileMimeType.size() > 0))
              && request.resource.data.text.size() >= 0))
          && (!request.resource.data.keys().hasAny(['viewOnce', 'viewedAt'])
            || (request.resource.data.keys().hasAll(['viewOnce'])
              && request.resource.data.viewOnce == true
              && !request.resource.data.keys().hasAny(['viewedAt'])
              && request.resource.data.keys().hasAny(['imageUrl', 'videoUrl'])))
          && ((get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantA == request.auth.uid
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantB == request.resource.data.recipientId)
            || (get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantB == request.auth.uid
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantA == request.resource.data.recipientId))
          && noBlockExists(request.resource.data.senderId, request.resource.data.recipientId)
          && exists(/databases/$(database)/documents/friendships/$(conversationId)))
          || validCallHistory(messageId);
        allow update: if request.auth != null
          && resource.data.recipientId == request.auth.uid
          && resource.data.viewOnce == true
          && !resource.data.keys().hasAny(['viewedAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedAt'])
          && request.resource.data.viewedAt is timestamp;
        allow delete: if false;
      }
    }

    match /calls/{callId} {
      function validCallFields(call) {
        return call.keys().hasAll([
            'conversationId', 'callerId', 'calleeId', 'kind', 'phase',
            'offerType', 'offerSdp', 'createdAt'
          ])
          && call.keys().hasOnly([
            'conversationId', 'callerId', 'calleeId', 'kind', 'phase',
            'offerType', 'offerSdp', 'createdAt', 'answerType', 'answerSdp',
            'answeredAt', 'endedAt', 'endedBy'
          ])
          && call.conversationId is string
          && call.callerId is string
          && call.calleeId is string
          && call.callerId != call.calleeId
          && call.kind == 'voice'
          && (call.phase == 'ringing' || call.phase == 'accepted'
            || call.phase == 'cancelled' || call.phase == 'declined' || call.phase == 'failed'
            || call.phase == 'ended')
          && call.offerType == 'offer'
          && call.offerSdp is string
          && call.offerSdp.size() > 0
          && call.offerSdp.size() <= 50000
          && call.createdAt is timestamp
          && (!call.keys().hasAny(['answerType', 'answerSdp', 'answeredAt'])
            || (call.keys().hasAll(['answerType', 'answerSdp', 'answeredAt'])
              && call.answerType == 'answer'
              && call.answerSdp is string
              && call.answerSdp.size() > 0
              && call.answerSdp.size() <= 50000
              && call.answeredAt is timestamp))
          && (!call.keys().hasAny(['endedAt', 'endedBy'])
            || (call.keys().hasAll(['endedAt', 'endedBy'])
              && call.endedAt is timestamp
              && call.endedBy is string));
      }

      function matchesConversationParticipants(call) {
        return call.conversationId is string
          && call.callerId is string
          && call.calleeId is string
          && exists(/databases/$(database)/documents/conversations/$(call.conversationId))
          && ((get(/databases/$(database)/documents/conversations/$(call.conversationId)).data.participantA == call.callerId
            && get(/databases/$(database)/documents/conversations/$(call.conversationId)).data.participantB == call.calleeId)
            || (get(/databases/$(database)/documents/conversations/$(call.conversationId)).data.participantB == call.callerId
              && get(/databases/$(database)/documents/conversations/$(call.conversationId)).data.participantA == call.calleeId));
      }

      function isCallParticipant(call) {
        return request.auth != null
          && (request.auth.uid == call.callerId || request.auth.uid == call.calleeId)
          && matchesConversationParticipants(call);
      }

      function validCandidate(candidate) {
        return candidate.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt'])
          && candidate.keys().hasAll(['candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt'])
          && candidate.candidate is string
          && candidate.candidate.size() > 0
          && candidate.candidate.size() <= 2000
          && (candidate.sdpMid == null || (candidate.sdpMid is string && candidate.sdpMid.size() <= 256))
          && (candidate.sdpMLineIndex == null || candidate.sdpMLineIndex is int)
          && candidate.createdAt is timestamp
          && candidate.createdAt == request.time;
      }

      // A call document can be fetched only after validating its immutable
      // participant/conversation relationship. Incoming-call discovery is a
      // bounded query, so its predicate must be directly provable from the
      // query fields; create/update rules preserve that same relationship.
      allow get: if isCallParticipant(resource.data) && validCallFields(resource.data);
      allow list: if request.auth != null
        && request.auth.uid == resource.data.calleeId
        && resource.data.phase == 'ringing'
        && request.query.limit <= 20;
      allow create: if request.auth != null
        && validCallFields(request.resource.data)
        && matchesConversationParticipants(request.resource.data)
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.phase == 'ringing'
        && noBlockExists(request.resource.data.callerId, request.resource.data.calleeId)
        && request.resource.data.keys().hasOnly([
          'conversationId', 'callerId', 'calleeId', 'kind', 'phase',
          'offerType', 'offerSdp', 'createdAt'
        ])
        && request.resource.data.createdAt == request.time;
      allow update: if isCallParticipant(resource.data)
        && validCallFields(resource.data)
        && validCallFields(request.resource.data)
        && matchesConversationParticipants(request.resource.data)
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.offerType == resource.data.offerType
        && request.resource.data.offerSdp == resource.data.offerSdp
        && request.resource.data.createdAt == resource.data.createdAt
        && ((request.auth.uid == resource.data.callerId
          && resource.data.phase == 'ringing'
          && request.resource.data.phase == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase', 'endedAt', 'endedBy'])
          && request.resource.data.endedAt == request.time
          && request.resource.data.endedBy == request.auth.uid)
          || (request.auth.uid == resource.data.calleeId
            && resource.data.phase == 'ringing'
            && !resource.data.keys().hasAny(['answerType', 'answerSdp', 'answeredAt'])
            && request.resource.data.phase == 'accepted'
            && noBlockExists(resource.data.callerId, resource.data.calleeId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'phase', 'answerType', 'answerSdp', 'answeredAt'
            ])
            && request.resource.data.answeredAt == request.time)
          || (request.auth.uid == resource.data.calleeId
            && resource.data.phase == 'ringing'
            && request.resource.data.phase == 'declined'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase', 'endedAt', 'endedBy'])
            && request.resource.data.endedAt == request.time
            && request.resource.data.endedBy == request.auth.uid)
          || ((request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId)
            && (resource.data.phase == 'ringing' || resource.data.phase == 'accepted')
            && request.resource.data.phase == 'failed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase', 'endedAt', 'endedBy'])
            && request.resource.data.endedAt == request.time
            && request.resource.data.endedBy == request.auth.uid)
          || ((request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId)
            && resource.data.phase == 'accepted'
            && request.resource.data.phase == 'ended'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase', 'endedAt', 'endedBy'])
            && request.resource.data.endedAt == request.time
            && request.resource.data.endedBy == request.auth.uid));
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if isCallParticipant(get(/databases/$(database)/documents/calls/$(callId)).data)
          && validCallFields(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if request.auth != null
          && validCandidate(request.resource.data)
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
          && isCallParticipant(get(/databases/$(database)/documents/calls/$(callId)).data)
          && (get(/databases/$(database)/documents/calls/$(callId)).data.phase == 'ringing'
            || get(/databases/$(database)/documents/calls/$(callId)).data.phase == 'accepted');
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if isCallParticipant(get(/databases/$(database)/documents/calls/$(callId)).data)
          && validCallFields(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if request.auth != null
          && validCandidate(request.resource.data)
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid
          && isCallParticipant(get(/databases/$(database)/documents/calls/$(callId)).data)
          && (get(/databases/$(database)/documents/calls/$(callId)).data.phase == 'ringing'
            || get(/databases/$(database)/documents/calls/$(callId)).data.phase == 'accepted');
        allow update, delete: if false;
      }
    }

    match /posts/{postId} {
      function canInteractWithPost() {
        let post = get(/databases/$(database)/documents/posts/$(postId)).data;
        return request.auth != null
          && exists(/databases/$(database)/documents/posts/$(postId))
          && (post.authorUid == request.auth.uid
            || exists(/databases/$(database)/documents/userFriends/$(request.auth.uid + '_' + post.authorUid)));
      }

      allow read: if request.auth != null
        && (resource.data.authorUid == request.auth.uid
          || exists(/databases/$(database)/documents/userFriends/$(request.auth.uid + '_' + resource.data.authorUid)));
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['authorUid', 'text', 'imageUrl', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (!request.resource.data.keys().hasAny(['imageUrl'])
          || (request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.matches('^https://[^ ]+$')))
        && (request.resource.data.text.size() > 0
          || request.resource.data.keys().hasAny(['imageUrl']))
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;

      match /likes/{userId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid
            || exists(/databases/$(database)/documents/userFriends/$(request.auth.uid + '_' + get(/databases/$(database)/documents/posts/$(postId)).data.authorUid)));
        allow create: if canInteractWithPost()
          && userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['userUid', 'createdAt'])
          && request.resource.data.userUid == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow delete: if canInteractWithPost() && userId == request.auth.uid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid
            || exists(/databases/$(database)/documents/userFriends/$(request.auth.uid + '_' + get(/databases/$(database)/documents/posts/$(postId)).data.authorUid)));
        allow create: if canInteractWithPost()
          && request.resource.data.keys().hasOnly(['authorUid', 'text', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt is timestamp;
        allow update: if canInteractWithPost()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorUid', 'text', 'createdAt'])
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if canInteractWithPost() && resource.data.authorUid == request.auth.uid;
      }
    }

    match /groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'name', 'createdBy', 'createdAt', 'updatedAt', 'memberIds', 'adminIds',
          'lastMessage', 'lastMessageAt', 'lastMessageSenderId'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 30
        && request.resource.data.memberIds.toSet().size() == request.resource.data.memberIds.size()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.adminIds is list
        && request.resource.data.adminIds.size() >= 1
        && request.resource.data.adminIds.toSet().size() == request.resource.data.adminIds.size()
        && request.auth.uid in request.resource.data.adminIds
        && request.resource.data.memberIds.toSet().hasAll(request.resource.data.adminIds.toSet())
        && request.resource.data.lastMessage == null
        && request.resource.data.lastMessageAt == null
        && request.resource.data.lastMessageSenderId == null;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.keys().hasOnly([
          'name', 'createdBy', 'createdAt', 'updatedAt', 'memberIds', 'adminIds',
          'lastMessage', 'lastMessageAt', 'lastMessageSenderId'
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 1
        && request.resource.data.memberIds.size() <= 30
        && request.resource.data.memberIds.toSet().size() == request.resource.data.memberIds.size()
        && request.resource.data.adminIds == resource.data.adminIds
        && request.resource.data.adminIds.size() >= 1
        && request.resource.data.memberIds.toSet().hasAll(request.resource.data.adminIds.toSet())
        && request.resource.data.createdBy in request.resource.data.memberIds
        && ((request.auth.uid in resource.data.adminIds
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.adminIds == resource.data.adminIds
          && request.resource.data.lastMessage == resource.data.lastMessage
          && request.resource.data.lastMessageAt == resource.data.lastMessageAt
          && request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll(['name', 'updatedAt']))
          || (request.auth.uid in resource.data.adminIds
            && request.resource.data.name == resource.data.name
            && request.resource.data.adminIds == resource.data.adminIds
            && request.resource.data.lastMessage == resource.data.lastMessage
            && request.resource.data.lastMessageAt == resource.data.lastMessageAt
            && request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.toSet().hasAll(resource.data.memberIds.toSet())
            && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['memberIds', 'updatedAt']))
          || (request.auth.uid in resource.data.adminIds
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.name == resource.data.name
            && request.resource.data.adminIds == resource.data.adminIds
            && request.resource.data.lastMessage == resource.data.lastMessage
            && request.resource.data.lastMessageAt == resource.data.lastMessageAt
            && request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId
            && request.resource.data.memberIds.size() + 1 == resource.data.memberIds.size()
            && resource.data.memberIds.toSet().hasAll(request.resource.data.memberIds.toSet())
            && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).size() == 1
            && resource.data.adminIds.toSet().difference(request.resource.data.memberIds.toSet()).size() == 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['memberIds', 'updatedAt']))
          || (!(request.auth.uid in resource.data.adminIds)
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.name == resource.data.name
            && request.resource.data.adminIds == resource.data.adminIds
            && request.resource.data.lastMessage == resource.data.lastMessage
            && request.resource.data.lastMessageAt == resource.data.lastMessageAt
            && request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId
            && request.resource.data.memberIds.size() + 1 == resource.data.memberIds.size()
            && resource.data.memberIds.toSet().hasAll(request.resource.data.memberIds.toSet())
            && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).hasOnly([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['memberIds', 'updatedAt']))
          || (request.auth.uid in resource.data.memberIds
            && request.resource.data.name == resource.data.name
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.adminIds == resource.data.adminIds
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessageAt is timestamp
            && request.resource.data.lastMessageSenderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage', 'lastMessageAt', 'lastMessageSenderId', 'updatedAt'
            ])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll([
              'lastMessage', 'lastMessageAt', 'lastMessageSenderId', 'updatedAt'
            ])))
        && (request.resource.data.lastMessage is string || request.resource.data.lastMessage == null)
        && (request.resource.data.lastMessageAt is timestamp || request.resource.data.lastMessageAt == null)
        && (request.resource.data.lastMessageSenderId is string || request.resource.data.lastMessageSenderId == null);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'imageUrl', 'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.createdAt is timestamp
          && ((request.resource.data.text.size() > 0
              && !request.resource.data.keys().hasAny(['imageUrl', 'videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType']))
            || (request.resource.data.keys().hasAny(['imageUrl'])
              && !request.resource.data.keys().hasAny(['videoUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType'])
              && request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.matches('^https://.*$'))
            || (request.resource.data.keys().hasAny(['videoUrl'])
              && !request.resource.data.keys().hasAny(['imageUrl', 'fileUrl', 'fileName', 'fileSize', 'fileMimeType'])
              && request.resource.data.videoUrl is string
              && request.resource.data.videoUrl.matches('^https://.*$'))
            || (request.resource.data.keys().hasAll(['fileUrl', 'fileName'])
              && !request.resource.data.keys().hasAny(['imageUrl', 'videoUrl'])
              && request.resource.data.fileUrl is string
              && request.resource.data.fileUrl.matches('^https://.*$')
              && request.resource.data.fileName is string
              && request.resource.data.fileName.size() > 0
              && (!request.resource.data.keys().hasAny(['fileSize']) || (request.resource.data.fileSize is int && request.resource.data.fileSize >= 0))
              && (!request.resource.data.keys().hasAny(['fileMimeType']) || (request.resource.data.fileMimeType is string && request.resource.data.fileMimeType.size() > 0))));
        allow update, delete: if false;
      }
    }
  }
}
