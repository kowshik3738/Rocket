      match /liveLocations/{shareId} {
        function isConvParticipant() {
          return isVerifiedUser()
            && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantA == request.auth.uid
              || get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantB == request.auth.uid)
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantA != get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantB
            && noBlockExists(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantA, get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantB)
            && exists(/databases/$(database)/documents/friendships/$(conversationId));
        }

        allow read: if isConvParticipant();
        allow create: if isConvParticipant()
          && request.resource.data.keys().hasOnly(['ownerId', 'latitude', 'longitude', 'startedAt', 'expiresAt', 'stoppedAt', 'updatedAt', 'durationMinutes'])
          && request.resource.data.keys().hasAll(['ownerId', 'latitude', 'longitude', 'startedAt', 'expiresAt', 'updatedAt', 'durationMinutes'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.latitude is number && request.resource.data.latitude >= -90.0 && request.resource.data.latitude <= 90.0
          && request.resource.data.longitude is number && request.resource.data.longitude >= -180.0 && request.resource.data.longitude <= 180.0
          && request.resource.data.startedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.stoppedAt == null
          && request.resource.data.durationMinutes in [15, 60, 480]
          && request.resource.data.expiresAt >= request.time + duration.value(request.resource.data.durationMinutes, 'm') - duration.value(1, 'm')
          && request.resource.data.expiresAt <= request.time + duration.value(request.resource.data.durationMinutes, 'm') + duration.value(1, 'm');
        allow update: if isConvParticipant()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.durationMinutes == resource.data.durationMinutes
          && (
            (resource.data.stoppedAt == null
              && request.time < resource.data.expiresAt
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['latitude', 'longitude', 'updatedAt'])
              && request.resource.data.diff(resource.data).affectedKeys().hasAll(['latitude', 'longitude', 'updatedAt'])
              && request.resource.data.latitude is number && request.resource.data.latitude >= -90.0 && request.resource.data.latitude <= 90.0
              && request.resource.data.longitude is number && request.resource.data.longitude >= -180.0 && request.resource.data.longitude <= 180.0
              && request.resource.data.updatedAt == request.time)
            ||
            (resource.data.stoppedAt == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stoppedAt', 'updatedAt'])
              && request.resource.data.diff(resource.data).affectedKeys().hasAll(['stoppedAt', 'updatedAt'])
              && request.resource.data.stoppedAt == request.time
              && request.resource.data.updatedAt == request.time)
          );
        allow delete: if false;
      }
    }

    match /calls/{callId} {
      function validCallFields(call) {
        return call.keys().hasAll([
            'conversationId', 'callerId', 'calleeId', 'kind', 'phase',
            'offerType', 'offerSdp', 'createdAt'
          ])
          && call.keys().hasOnly([
            'conversationId', 'callerId', 'calleeId', 'kind', 'phase',
            'offerType', 'offerSdp', 'createdAt', 'answerType', 'answerSdp',
            'answeredAt', 'endedAt', 'endedBy'
          ])
