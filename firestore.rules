                  && request.resource.data.fileSize >= 0))
              && (!request.resource.data.keys().hasAny(['fileMimeType'])
                || (request.resource.data.fileMimeType is string
                  && request.resource.data.fileMimeType.size() > 0))
              && request.resource.data.text.size() >= 0)
            || (request.resource.data.keys().hasAll(['location', 'locationType'])
