        && request.resource.data.lastMessage == null
        && request.resource.data.lastMessageAt == null
        && request.resource.data.lastMessageSenderId == null
        && (
          (
            request.resource.data.participantA != request.resource.data.participantB
            && ((request.resource.data.participantA < request.resource.data.participantB
              && conversationId == request.resource.data.participantA + '_' + request.resource.data.participantB)
              || (request.resource.data.participantB < request.resource.data.participantA
              && conversationId == request.resource.data.participantB + '_' + request.resource.data.participantA))
            && (request.auth.uid == request.resource.data.participantA || request.auth.uid == request.resource.data.participantB)
            && noBlockExists(request.resource.data.participantA, request.resource.data.participantB)
