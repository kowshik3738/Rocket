rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function noBlockExists(userA, userB) {
      return !exists(/databases/$(database)/documents/userBlocks/$(userA + '_' + userB))
        && !exists(/databases/$(database)/documents/userBlocks/$(userB + '_' + userA));
    }


    match /privacyLists/{userId} {
      allow read: if isVerifiedUser() && request.auth.uid == userId;
      allow create, update: if isVerifiedUser()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['ownerUid', 'closeFriends', 'hiddenFrom', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.closeFriends is list
        && request.resource.data.closeFriends.size() <= 200
        && request.resource.data.hiddenFrom is list
        && request.resource.data.hiddenFrom.size() <= 200
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }


    match /storyDiscovery/{storyId} {
      allow read: if isVerifiedUser()
        && (
          resource.data.authorUid == request.auth.uid
          || request.auth.uid in resource.data.allowedViewers
        );
      allow create: if isVerifiedUser()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['authorUid', 'expiresAt', 'allowedViewers', 'tier', 'type'])
        && request.resource.data.allowedViewers is list
        && request.resource.data.allowedViewers.size() <= 500
        && !(request.auth.uid in request.resource.data.allowedViewers)
        && request.resource.data.expiresAt >= request.time + duration.value(24, 'h') - duration.value(5, 'm')
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h') + duration.value(5, 'm');
      allow update: if isVerifiedUser()
        && resource.data.authorUid == request.auth.uid
        && request.time < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowedViewers'])
        && request.resource.data.allowedViewers is list
        && request.resource.data.allowedViewers.size() <= 500
        && !(request.auth.uid in request.resource.data.allowedViewers);
      allow delete: if isVerifiedUser() && resource.data.authorUid == request.auth.uid;
    }

    match /stories/{storyId} {
      function hasFriendship(userA, userB) {
        let sorted = userA < userB ? userA + '_' + userB : userB + '_' + userA;
        return exists(/databases/$(database)/documents/friendships/$(sorted));
      }
      function getPrivacy(uid) {
        let doc = get(/databases/$(database)/documents/privacyLists/$(uid));
        return doc != null ? doc.data : {'closeFriends': [], 'hiddenFrom': []};
      }

      allow list: if isVerifiedUser()
        && resource.data.authorUid == request.auth.uid;

      allow get: if isVerifiedUser()
        && (
          (resource.data.authorUid == request.auth.uid && request.time < resource.data.expiresAt)
          || (
            request.time < resource.data.expiresAt
            && hasFriendship(request.auth.uid, resource.data.authorUid)
            && noBlockExists(request.auth.uid, resource.data.authorUid)
            && !(request.auth.uid in getPrivacy(resource.data.authorUid).hiddenFrom)
            && (
              resource.data.tier == 'friends'
              || (resource.data.tier == 'closeFriends' && request.auth.uid in getPrivacy(resource.data.authorUid).closeFriends)
              || (resource.data.tier == 'selected' && request.auth.uid in resource.data.selectedIds)
            )
          )
        );

      allow create: if isVerifiedUser()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['authorUid', 'type', 'tier', 'selectedIds', 'mediaUrl', 'text', 'backgroundColor', 'createdAt', 'expiresAt'])
        && request.resource.data.tier in ['friends', 'closeFriends', 'selected']
        && (request.resource.data.tier != 'selected' ? request.resource.data.selectedIds == null : (request.resource.data.selectedIds is list && request.resource.data.selectedIds.size() <= 50))
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt >= request.time + duration.value(24, 'h') - duration.value(5, 'm')
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h') + duration.value(5, 'm')
        && (
          (request.resource.data.type == 'image'
            && request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.matches('^https://res\\.cloudinary\\.com/cmpoe94k/image/upload/.*$')
            && request.resource.data.text == null && request.resource.data.backgroundColor == null)
          ||
          (request.resource.data.type == 'video'
            && request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.matches('^https://res\\.cloudinary\\.com/cmpoe94k/video/upload/.*$')
            && request.resource.data.text == null && request.resource.data.backgroundColor == null)
          ||
          (request.resource.data.type == 'text'
            && request.resource.data.mediaUrl == null
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
            && request.resource.data.backgroundColor in ['classic', 'modern', 'neon', 'mono'])
        );

      allow update: if false;

      allow delete: if isVerifiedUser() && resource.data.authorUid == request.auth.uid;

      match /viewers/{viewerUid} {
        // Author can read (get + list) all viewer receipts for their own story.
        allow read: if isVerifiedUser()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid == request.auth.uid;

        // A viewer can GET only their own receipt, and only while they are currently
        // authorized to access the parent story (active, friended, not blocked, not hidden, correct tier).
        allow get: if isVerifiedUser()
          && viewerUid == request.auth.uid
          && request.time < get(/databases/$(database)/documents/stories/$(storyId)).data.expiresAt
          && hasFriendship(request.auth.uid, get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)
          && noBlockExists(request.auth.uid, get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)
          && !(request.auth.uid in getPrivacy(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid).hiddenFrom)
          && (
            get(/databases/$(database)/documents/stories/$(storyId)).data.tier == 'friends'
            || (get(/databases/$(database)/documents/stories/$(storyId)).data.tier == 'closeFriends' && request.auth.uid in getPrivacy(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid).closeFriends)
            || (get(/databases/$(database)/documents/stories/$(storyId)).data.tier == 'selected' && request.auth.uid in get(/databases/$(database)/documents/stories/$(storyId)).data.selectedIds)
          );

        allow create: if isVerifiedUser()
          && viewerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['viewerUid', 'viewedAt'])
          && request.resource.data.viewerUid == request.auth.uid
          && request.resource.data.viewedAt == request.time
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid != request.auth.uid
          && request.time < get(/databases/$(database)/documents/stories/$(storyId)).data.expiresAt
          && hasFriendship(request.auth.uid, get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)
          && noBlockExists(request.auth.uid, get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid)
          && !(request.auth.uid in getPrivacy(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid).hiddenFrom)
          && (
            get(/databases/$(database)/documents/stories/$(storyId)).data.tier == 'friends'
            || (get(/databases/$(database)/documents/stories/$(storyId)).data.tier == 'closeFriends' && request.auth.uid in getPrivacy(get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid).closeFriends)
            || (get(/databases/$(database)/documents/stories/$(storyId)).data.tier == 'selected' && request.auth.uid in get(/databases/$(database)/documents/stories/$(storyId)).data.selectedIds)
          );

        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow read: if isVerifiedUser();
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'usernameLower', 'bio', 'createdAt', 'photoUrl'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 150
        && request.resource.data.usernameLower.matches('^[a-z0-9_.]{3,30}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && (!request.resource.data.keys().hasAny(['photoUrl'])
          || (request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.matches('^https://res[.]cloudinary[.]com/cmpoe94k/image/upload/[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$')))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == request.auth.uid;
      allow update: if isVerifiedUser()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.matches('^[a-z0-9_.]{3,30}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 150
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'usernameLower', 'bio', 'createdAt', 'photoUrl'
        ])
        && (!request.resource.data.keys().hasAny(['photoUrl'])
          || (request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.matches('^https://res[.]cloudinary[.]com/cmpoe94k/image/upload/[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$')))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == request.auth.uid
        && (request.resource.data.usernameLower == resource.data.usernameLower
          || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.usernameLower)));
      allow delete: if false;

      match /chatPreferences/{chatKey} {
        allow read: if isVerifiedUser() && request.auth.uid == userId;
        allow create: if isVerifiedUser()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['chatId', 'chatType', 'ownerUid', 'pinned', 'pinnedAt', 'archived', 'archivedAt', 'muted', 'mutedAt', 'mutedStories', 'mutedStoriesAt', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['chatId', 'chatType', 'ownerUid', 'pinned', 'archived', 'muted', 'updatedAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.chatId == chatKey
          && request.resource.data.chatId is string
          && request.resource.data.chatId.size() > 0
          && request.resource.data.chatId.size() <= 128
          && request.resource.data.chatType in ['direct', 'group']
          && request.resource.data.pinned is bool
          && request.resource.data.archived is bool
          && request.resource.data.muted is bool
          && (!request.resource.data.keys().hasAny(['pinnedAt']) || request.resource.data.pinnedAt == null || request.resource.data.pinnedAt is timestamp)
          && (!request.resource.data.keys().hasAny(['archivedAt']) || request.resource.data.archivedAt == null || request.resource.data.archivedAt is timestamp)
          && (!request.resource.data.keys().hasAny(['mutedAt']) || request.resource.data.mutedAt == null || request.resource.data.mutedAt is timestamp)
          && (!request.resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt is timestamp)
          && request.resource.data.updatedAt is timestamp;
        allow update: if isVerifiedUser()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['chatId', 'chatType', 'ownerUid', 'pinned', 'pinnedAt', 'archived', 'archivedAt', 'muted', 'mutedAt', 'mutedStories', 'mutedStoriesAt', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['chatId', 'chatType', 'ownerUid', 'pinned', 'archived', 'muted', 'updatedAt'])
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.chatId == resource.data.chatId
          && request.resource.data.chatType == resource.data.chatType
          && request.resource.data.pinned is bool
          && request.resource.data.archived is bool
          && request.resource.data.muted is bool
          && (!request.resource.data.keys().hasAny(['pinnedAt']) || request.resource.data.pinnedAt == null || request.resource.data.pinnedAt is timestamp)
          && (!request.resource.data.keys().hasAny(['archivedAt']) || request.resource.data.archivedAt == null || request.resource.data.archivedAt is timestamp)
          && (!request.resource.data.keys().hasAny(['mutedAt']) || request.resource.data.mutedAt == null || request.resource.data.mutedAt is timestamp)
          && (!resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt == resource.data.createdAt)
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isVerifiedUser() && request.auth.uid == userId;
      }
      match /pushTokens/{deviceId} {
       allow read, delete: if isVerifiedUser()
         && request.auth.uid == userId
         && deviceId.matches('^[A-Za-z0-9_-]{1,160}$');

       allow create, update: if isVerifiedUser()
         && request.auth.uid == userId
         && deviceId.matches('^[A-Za-z0-9_-]{1,160}$')
         && request.resource.data.keys().hasOnly([
           'token', 'platform', 'updatedAt', 'preferences'
         ])
         && request.resource.data.keys().hasAll([
           'token', 'platform', 'updatedAt'
         ])
         && request.resource.data.token is string
         && request.resource.data.token.size() > 0
         && request.resource.data.token.size() <= 4096
         && (request.resource.data.platform == 'android'
           || request.resource.data.platform == 'ios')
         && (!request.resource.data.keys().hasAny(['preferences'])
           || (request.resource.data.preferences is map
             && request.resource.data.preferences.keys().hasOnly(['messages', 'calls', 'social'])
             && (!request.resource.data.preferences.keys().hasAny(['messages']) || request.resource.data.preferences.messages is bool)
             && (!request.resource.data.preferences.keys().hasAny(['calls']) || request.resource.data.preferences.calls is bool)
             && (!request.resource.data.preferences.keys().hasAny(['social']) || request.resource.data.preferences.social is bool)))
         && request.resource.data.updatedAt == request.time;
      }
    }

    match /usernames/{usernameLower} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && usernameLower.matches('^[a-z0-9_.]{3,30}$')
        && usernameLower == usernameLower.lower()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isVerifiedUser()
        && resource.data.uid == request.auth.uid;
    }

    match /userBlocks/{blockId} {
      allow get: if isVerifiedUser()
        && (resource == null
          ? blockId.matches('^' + request.auth.uid + '_.*$')
          : resource.data.blockerUid == request.auth.uid);
      allow list: if isVerifiedUser()
        && resource.data.blockerUid == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(['blockerUid', 'blockedUid', 'createdAt'])
        && blockId == request.resource.data.blockerUid + '_' + request.resource.data.blockedUid
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid != request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isVerifiedUser()
        && resource.data.blockerUid == request.auth.uid;
    }

    match /userReports/{reportId} {
      allow read: if false;
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasAll(['reporterUid', 'reportedUid', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['reporterUid', 'reportedUid', 'reason', 'details', 'createdAt'])
        && reportId == request.resource.data.reporterUid + '_' + request.resource.data.reportedUid
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid.size() > 0
        && request.resource.data.reportedUid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.reportedUid))
        && request.resource.data.reason in [
          'spam', 'harassment', 'inappropriate_content', 'impersonation', 'scam', 'other'
        ]
        && (!request.resource.data.keys().hasAny(['details'])
          || (request.resource.data.details is string && request.resource.data.details.size() <= 500))
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /friendRequests/{requestId} {
      function noFriendshipExists(senderId, recipientId) {
        return (senderId < recipientId
          && !exists(/databases/$(database)/documents/friendships/$(senderId + '_' + recipientId)))
          || (senderId > recipientId
            && !exists(/databases/$(database)/documents/friendships/$(recipientId + '_' + senderId)));
      }

      function hasNoActiveReverseRequest(senderId, recipientId) {
        return !exists(/databases/$(database)/documents/friendRequests/$(recipientId + '_' + senderId))
          || get(/databases/$(database)/documents/friendRequests/$(recipientId + '_' + senderId)).data.status == 'declined';
      }

      function canStartFriendRequest(senderId, recipientId) {
        return noFriendshipExists(senderId, recipientId)
          && hasNoActiveReverseRequest(senderId, recipientId)
          && noBlockExists(senderId, recipientId);
      }

      function hasAuthoritativeFriendshipAfter(friendRequest) {
        return ((friendRequest.senderId < friendRequest.recipientId
          && existsAfter(/databases/$(database)/documents/friendships/$(friendRequest.senderId + '_' + friendRequest.recipientId)))
          || (friendRequest.senderId > friendRequest.recipientId
            && existsAfter(/databases/$(database)/documents/friendships/$(friendRequest.recipientId + '_' + friendRequest.senderId))))
          && existsAfter(/databases/$(database)/documents/userFriends/$(friendRequest.senderId + '_' + friendRequest.recipientId))
          && existsAfter(/databases/$(database)/documents/userFriends/$(friendRequest.recipientId + '_' + friendRequest.senderId));
      }

      function hasAuthoritativeFriendshipRemovedAfter(friendRequest) {
        return ((friendRequest.senderId < friendRequest.recipientId
          && !existsAfter(/databases/$(database)/documents/friendships/$(friendRequest.senderId + '_' + friendRequest.recipientId)))
          || (friendRequest.senderId > friendRequest.recipientId
            && !existsAfter(/databases/$(database)/documents/friendships/$(friendRequest.recipientId + '_' + friendRequest.senderId))))
          && !existsAfter(/databases/$(database)/documents/userFriends/$(friendRequest.senderId + '_' + friendRequest.recipientId))
          && !existsAfter(/databases/$(database)/documents/userFriends/$(friendRequest.recipientId + '_' + friendRequest.senderId));
      }

      allow read: if isVerifiedUser()
        && (resource == null || resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(['senderId', 'recipientId', 'status', 'createdAt'])
        && requestId == request.resource.data.senderId + '_' + request.resource.data.recipientId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && canStartFriendRequest(request.resource.data.senderId, request.resource.data.recipientId);
      allow update: if isVerifiedUser()
        && request.resource.data.keys().hasOnly([
          'senderId', 'recipientId', 'status', 'createdAt', 'acceptedAt', 'declinedAt'
        ])
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.createdAt == resource.data.createdAt
        && ((resource.data.recipientId == request.auth.uid
          && resource.data.status == 'pending'
          && ((request.resource.data.status == 'accepted'
            && request.resource.data.acceptedAt is timestamp
            && !request.resource.data.keys().hasAny(['declinedAt'])
            && noBlockExists(resource.data.senderId, resource.data.recipientId)
            && hasAuthoritativeFriendshipAfter(request.resource.data))
            || (request.resource.data.status == 'declined'
              && request.resource.data.declinedAt is timestamp
              && !request.resource.data.keys().hasAny(['acceptedAt']))))
          || (resource.data.senderId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'declined'
            && request.resource.data.declinedAt is timestamp
            && !request.resource.data.keys().hasAny(['acceptedAt']))
          || (resource.data.senderId == request.auth.uid
            && resource.data.status == 'declined'
            && request.resource.data.keys().hasOnly(['senderId', 'recipientId', 'status', 'createdAt'])
            && request.resource.data.status == 'pending'
            && canStartFriendRequest(resource.data.senderId, resource.data.recipientId))
          || ((resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid)
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'declined'
            && request.resource.data.declinedAt is timestamp
            && !request.resource.data.keys().hasAny(['acceptedAt'])
            && hasAuthoritativeFriendshipRemovedAfter(resource.data)));
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      function matchesAcceptedFriendRequest(friendship) {
        let friendRequest = getAfter(/databases/$(database)/documents/friendRequests/$(friendship.requestId)).data;
        return friendRequest.status == 'accepted'
          && ((friendRequest.senderId == friendship.userA
            && friendRequest.recipientId == friendship.userB)
            || (friendRequest.senderId == friendship.userB
              && friendRequest.recipientId == friendship.userA));
      }

      allow read: if isVerifiedUser()
        && (resource == null || resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(['userA', 'userB', 'requestId', 'createdAt'])
        && ((request.resource.data.userA < request.resource.data.userB
          && friendshipId == request.resource.data.userA + '_' + request.resource.data.userB)
          || (request.resource.data.userB < request.resource.data.userA
          && friendshipId == request.resource.data.userB + '_' + request.resource.data.userA))
        && request.resource.data.userA != request.resource.data.userB
        && (request.auth.uid == request.resource.data.userA || request.auth.uid == request.resource.data.userB)
        && request.resource.data.createdAt is timestamp
        && noBlockExists(request.resource.data.userA, request.resource.data.userB)
        && matchesAcceptedFriendRequest(request.resource.data);
      allow update: if false;
      allow delete: if isVerifiedUser()
        && (request.auth.uid == resource.data.userA || request.auth.uid == resource.data.userB)
        && getAfter(/databases/$(database)/documents/friendRequests/$(resource.data.requestId)).data.status == 'declined'
        && !existsAfter(/databases/$(database)/documents/userFriends/$(resource.data.userA + '_' + resource.data.userB))
        && !existsAfter(/databases/$(database)/documents/userFriends/$(resource.data.userB + '_' + resource.data.userA));
    }

    match /userFriends/{friendshipId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(['ownerId', 'friendId', 'requestId', 'createdAt'])
        && friendshipId == request.resource.data.ownerId + '_' + request.resource.data.friendId
        && request.resource.data.ownerId != request.resource.data.friendId
        && (request.auth.uid == request.resource.data.ownerId || request.auth.uid == request.resource.data.friendId)
        && request.resource.data.createdAt is timestamp
        && noBlockExists(request.resource.data.ownerId, request.resource.data.friendId)
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
        && ((getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId == request.resource.data.ownerId
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.recipientId == request.resource.data.friendId)
          || (getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId == request.resource.data.friendId
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.recipientId == request.resource.data.ownerId));
      allow update: if false;
      allow delete: if isVerifiedUser()
        && (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.friendId)
        && getAfter(/databases/$(database)/documents/friendRequests/$(resource.data.requestId)).data.status == 'declined'
        && ((resource.data.ownerId < resource.data.friendId
          && !existsAfter(/databases/$(database)/documents/friendships/$(resource.data.ownerId + '_' + resource.data.friendId)))
          || (resource.data.friendId < resource.data.ownerId
          && !existsAfter(/databases/$(database)/documents/friendships/$(resource.data.friendId + '_' + resource.data.ownerId))))
        && !existsAfter(/databases/$(database)/documents/userFriends/$(resource.data.friendId + '_' + resource.data.ownerId));
    }

    match /userPresence/{userId} {
      allow read: if isVerifiedUser();
      allow create, update: if isVerifiedUser()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'state', 'lastSeen', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'state', 'updatedAt'])
        && request.resource.data.state in ['online', 'offline']
        && (!request.resource.data.keys().hasAny(['lastSeen'])
