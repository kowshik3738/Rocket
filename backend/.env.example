# Rocket Push Notification Backend Environment Variables
PORT=8080

# Option 1: Provide full Service Account JSON as a single line string
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"rocket-87c6a",...}'

# Option 2: Provide individual Firebase Service Account fields
FIREBASE_PROJECT_ID=rocket-87c6a
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@rocket-87c6a.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="<paste-private-key-from-service-account-json>"
